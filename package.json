{
  "name": "pi-session-surgery",
  "version": "0.1.3",
  "description": "Safely rebuild and switch Pi sessions after removing persisted tool history.",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "session",
    "prune",
    "surgery"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexshpunt/pi-session-surgery.git"
  },
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-session-surgery/issues"
  },
  "homepage": "https://github.com/alexshpunt/pi-session-surgery#readme",
  "publishConfig": {
    "access": "public"
  }
}
